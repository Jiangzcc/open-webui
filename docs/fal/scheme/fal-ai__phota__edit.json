{"openapi":"3.0.4","info":{"title":"Queue OpenAPI for fal-ai/phota/edit","version":"1.0.0","description":"The OpenAPI schema for the fal-ai/phota/edit queue.","x-fal-metadata":{"endpointId":"fal-ai/phota/edit","category":"image-to-image","thumbnailUrl":"https://v3b.fal.media/files/b/0a93b8fc/3UCkN5HYIJMfui9wNis3X_162f28fa834741318aa99b9d46047e9e.jpg","playgroundUrl":"https://fal.ai/models/fal-ai/phota/edit","documentationUrl":"https://fal.ai/models/fal-ai/phota/edit/api","about":"Edit an image based on a text description using Phota."}},"components":{"securitySchemes":{"apiKeyAuth":{"type":"apiKey","in":"header","name":"Authorization","description":"Fal Key"}},"schemas":{"QueueStatus":{"type":"object","properties":{"status":{"type":"string","enum":["IN_QUEUE","IN_PROGRESS","COMPLETED"]},"request_id":{"type":"string","description":"The request id."},"response_url":{"type":"string","description":"The response url."},"status_url":{"type":"string","description":"The status url."},"cancel_url":{"type":"string","description":"The cancel url."},"logs":{"type":"object","description":"The logs.","additionalProperties":true},"metrics":{"type":"object","description":"The metrics.","additionalProperties":true},"queue_position":{"type":"integer","description":"The queue position."}},"required":["status","request_id"]},"PhotaEditInput":{"properties":{"num_images":{"minimum":1,"maximum":4,"description":"Number of images to generate.","default":1,"title":"Number of Images","type":"integer"},"prompt":{"examples":["Make this scene more realistic but still keep the game vibes"],"description":"Text description of the desired image. To refer to specific profiles, use [[profile_id_1]], [[profile_id_2]], etc.","maxLength":8000,"title":"Prompt","type":"string"},"resolution":{"description":"Resolution of the generated image.","default":"1K","title":"Resolution","type":"string","enum":["1K","4K"]},"image_urls":{"minItems":1,"description":"List of URLs/ Base64 data URIs of the images to edit.