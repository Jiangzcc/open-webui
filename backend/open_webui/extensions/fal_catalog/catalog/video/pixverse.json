[
	{
		"id": "fal-ai/pixverse/c1/image-to-video",
		"public_id": "pixverse/c1/image-to-video",
		"name": "PixVerse / C1 Image",
		"provider": "pixverse",
		"task": "image-to-video",
		"prompt_required": true,
		"asset_inputs": [
			{
				"role": "start_image",
				"field": "image_url",
				"required": true,
				"mime_types": ["image/jpeg", "image/png", "image/webp"],
				"max_bytes": 31457280
			}
		],
		"audio_options": [
			{
				"mode": "silent",
				"values": {
					"generate_audio_switch": false
				}
			},
			{
				"mode": "generate",
				"values": {
					"generate_audio_switch": true
				}
			}
		],
		"default_audio_mode": "silent",
		"resolution_field": "resolution",
		"resolutions": ["360p", "540p", "720p", "1080p"],
		"default_resolution": "720p",
		"duration_field": "duration",
		"duration_min": 1,
		"duration_max": 15,
		"duration_step": 1,
		"default_duration": "5",
		"integer_fields": [
			{
				"field": "seed"
			}
		]
	},
